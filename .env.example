# 复制为 .env 后填写；不提交 .env。密码建议使用密码管理器生成的随机字母数字。
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# 与 MYSQL_PASSWORD 一致；若使用其他字符，URL 中需要百分号编码。
ORG_DATABASE_URL=mysql+pymysql://organization:REPLACE_PASSWORD@mysql:3306/organization?charset=utf8mb4
# 至少 32 字符随机值，禁止使用示例固定值。
ORG_SESSION_SECRET=
ORG_FEISHU_APP_ID=
ORG_FEISHU_APP_SECRET=
ORG_FEISHU_TENANT_KEY=
# 仅用于展示已核验的权限名，逗号分隔；不是授权范围证明。
ORG_FEISHU_SCOPES=
ORG_FEISHU_REDIRECT_URI=https://organization.example.com/admin/auth/callback
# 完成真实企业验收后才填写证据引用并设为 true；默认不能声称覆盖全员。
ORG_COVERAGE_ACCEPTANCE_REFERENCE=
ORG_COVERAGE_ALL_MEMBERS_VERIFIED=false
ORG_COVERAGE_DEPARTMENTLESS_VERIFIED=false
# 使用同一飞书应用下的 open_id，逗号分隔；不是姓名、手机号或工号。
ORG_INITIAL_ADMIN_OPEN_IDS=
ORG_PORT=8000

# 内部能力边界仅向受信任 sidecar 开放；反向代理禁止公开 /internal 路径。
# 独立随机服务令牌，留空时所有内部能力请求均拒绝；与只读 API 密钥和管理员会话分离。
ORG_AGENT_SERVICE_TOKEN=
# 只允许 production 或 test；可信身份 header 必须与此值匹配。
ORG_AGENT_ENVIRONMENT=production
